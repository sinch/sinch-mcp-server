###############################################################################
# How the server picks a mode
#
#   MCP_AUTH_MODE unset  -> SINGLE-TENANT. PROJECT_ID, KEY_ID and KEY_SECRET are
#                           required; every call transacts on that account. This
#                           is the local development setup, and the rest of
#                           section 1 is all you need.
#   MCP_AUTH_MODE set    -> MULTI-TENANT. Callers bring their own credentials and
#                           PROJECT_ID / KEY_ID / KEY_SECRET are NEVER read. See
#                           section 4; this is how staging and production run.
#
# MCP_AUTH_MODE is read first, so leaving credentials below set does not pull a
# multi-tenant server back onto one account. A value that is set but unrecognised
# is a startup error, never a fall back to single-tenant.
###############################################################################

###############################################################################
# 1. REQUIRED — local development (single-tenant)
###############################################################################
# Sinch project credentials. All three, or the server refuses to start.
PROJECT_ID=
KEY_ID=
KEY_SECRET=

###############################################################################
# 2. Optional — per-tool settings and credentials
#
# Only needed for the tool families you actually exercise. Conversation and
# Numbers run on the triple above; Verification, Voice and Email need their own.
###############################################################################
# Conversation region. Optional in single-tenant (defaults to "us") and
# overridable from the prompt. REQUIRED and fixed in multi-tenant — see section 4.
CONVERSATION_REGION=
CONVERSATION_APP_ID=
DEFAULT_SMS_ORIGINATOR=
GEOCODING_API_KEY=
# Verification / Voice
APPLICATION_KEY=
APPLICATION_SECRET=
# Voice specific variable
CALLING_LINE_IDENTIFICATION=
# Email (Mailgun)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_SENDER_ADDRESS=
# Comma-separated tag allow-list restricting which tools are registered.
# Empty = no filter = every tool, which is what you want locally.
# MCP_TAGS=conversation,verification

###############################################################################
# 3. HTTP server only (npm run start:http:server)
#
# Not needed for stdio (npm run start:stdio), which is the usual local flow.
###############################################################################
PORT=8000
# Redis backs the MCP session registry. REDIS_HOST and REDIS_PORT are both
# required — the HTTP server exits immediately on startup without them, in every
# mode. REDIS_PASSWORD is optional; TLS turns on automatically once it is set.
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=
# Session idle TTL in seconds (default 1800)
# MCP_SESSION_TTL_SECONDS=1800

###############################################################################
# 4. Multi-tenant — how staging and production run
#
# Kept here so the deployed shape can be reproduced locally. Leave MCP_AUTH_MODE
# empty for ordinary local work: setting it switches tenancy, and section 1 is
# then ignored entirely.
###############################################################################
# Selects multi-tenant and pins the ONE inbound auth shape accepted on /mcp:
#
#   client-credentials  Authorization: Bearer <base64(projectId:keyId:keySecret)>
#                       carrying the caller's own credentials. The tools run on
#                       whatever the caller sent.
#   sinchid-agent       Authorization: Bearer <SinchID access token>, plus an
#                       x-agent-id header naming the agent installation the
#                       credentials are resolved from.
#
# Anything else is a startup error. CONVERSATION_REGION (section 2) becomes
# required and can no longer be overridden per request: one region per deployment.
MCP_AUTH_MODE=
# Max cached OAuth clients per distinct credential (LRU eviction, default 256)
# OAUTH_TOKEN_CACHE_MAX_ENTRIES=256

###############################################################################
# 5. Telemetry and logging (optional)
#
# Local stdio usage: leave the endpoint unset — telemetry disabled, zero overhead.
# Hosted K8s: injected by Kyverno (kyverno.sinch.com/add-otel-endpoint: "enabled")
# or Helm. Typical cluster-local collector endpoint (OTLP gRPC):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy-daemonset.otel-collector.svc.cluster.local:4317
###############################################################################
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sinch-mcp-server
OTEL_PROPAGATORS=tracecontext,baggage
LOG_LEVEL=info

###############################################################################
# 6. LLM integration/eval test suites only
#
# Provider keys — see tests/integration/llms/README.md
###############################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (provider/model)
OPENAI_MODEL= # openai/gpt-5-mini, openai/gpt-5-nano, openai/gpt-5.6-terra, openai/gpt-5.6-luna
ANTHROPIC_MODEL=
GEMINI_MODEL= # google/gemini-3.1-pro, google/gemini-3.5-flash, google/gemini-2.5-pro
WORKFLOW_MODEL=
