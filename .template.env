###############################################################################
# REQUIRED — local development
###############################################################################
# Sinch project credentials. All three, or the server refuses to start.
PROJECT_ID=
KEY_ID=
KEY_SECRET=

###############################################################################
# Optional — per-tool settings and credentials
#
# Only needed for the tool families you actually exercise. Conversation,
# Numbers, and Voice APIs run on the triple above; Verification and Email need
# their own.
###############################################################################
# Conversation region. Optional (defaults to "us") and overridable from the prompt.
CONVERSATION_REGION=
CONVERSATION_APP_ID=
DEFAULT_SMS_ORIGINATOR=
GEOCODING_API_KEY=
# Verification
APPLICATION_KEY=
APPLICATION_SECRET=
# Voice: optional default active Sinch Voice number used by tts-callout and tts-batch-callout
CALLING_LINE_IDENTIFICATION=
# Email (Mailgun)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_SENDER_ADDRESS=
# Comma-separated tag allow-list restricting which tools are registered.
# Empty = no filter = every tool, which is what you want locally.
# MCP_TAGS=conversation,verification

###############################################################################
# Sinch API hosts (optional)
#
# Leave them unset to call the production Sinch APIs, shown here as the defaults.
# Set one to send that API somewhere else, such as a local mock. Scheme and host
# only, with no path and no trailing slash; the server refuses to start otherwise.
# CONVERSATION and TEMPLATES may keep the {region} placeholder, which the server
# fills with the conversation region (us. / eu. / br.). A host without it is used as-is.
###############################################################################
# SINCH_AUTH_URL=https://auth.sinch.com
# SINCH_CONVERSATION_URL=https://{region}conversation.api.sinch.com
# SINCH_TEMPLATES_URL=https://{region}template.api.sinch.com
# SINCH_NUMBERS_URL=https://numbers.api.sinch.com
# SINCH_VOICE_URL=https://voice.api.sinch.com
# SINCH_NUMBER_LOOKUP_URL=https://lookup.api.sinch.com
# SINCH_VERIFICATION_URL=https://verification.api.sinch.com
# SINCH_PROVISIONING_URL=https://provisioning.api.sinch.com

###############################################################################
# Logging (optional)
###############################################################################
LOG_LEVEL=info

###############################################################################
# LLM integration/eval test suites only
#
# Provider keys — see tests/integration/llms/README.md
###############################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (provider/model)
OPENAI_MODEL= # openai/gpt-5-mini, openai/gpt-5-nano, openai/gpt-5.6-terra, openai/gpt-5.6-luna
ANTHROPIC_MODEL=
GEMINI_MODEL= # google/gemini-3.1-pro, google/gemini-3.5-flash, google/gemini-2.5-pro
WORKFLOW_MODEL=
