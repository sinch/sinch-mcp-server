# Remote HTTP server (npm run start:http:server)
PORT=8000
# REQUIRED for the HTTP server — the deployment mode and the one inbound auth shape it accepts.
# Every mode authenticates through Authorization: Bearer <token>; what the token is differs.
#   server-credentials  Single-tenant. Token is base64(projectId:keyId:keySecret) and must match
#                       the PROJECT_ID/KEY_ID/KEY_SECRET set below; tools run on those.
#                       All three are required, and the server refuses to start without them.
#   client-credentials  Multi-tenant. Token is the caller's own base64(projectId:keyId:keySecret)
#                       and the tools run on it. CONVERSATION_REGION is required.
#   sinchid-agent       Multi-tenant. Token is a SinchID access token, plus an x-agent-id header.
MCP_AUTH_MODE=server-credentials
# Multi-tenant only: max cached OAuth clients per distinct credential (LRU eviction, default 256)
# OAUTH_TOKEN_CACHE_MAX_ENTRIES=256
# HTTP only: Redis for shared session storage across pods. REDIS_HOST and REDIS_PORT are
# both required — the HTTP server fails to start without them. REDIS_PASSWORD is optional;
# TLS turns on automatically once it's set.
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=
# HTTP only: session idle TTL in seconds (default 1800)
# MCP_SESSION_TTL_SECONDS=1800
# Optional: comma-separated list of tags to filter the exposed tools (fallback when no --tags option is provided)
# MCP_TAGS=conversation,verification

# Conversation / Numbers tools related environment variables for authentication
PROJECT_ID=
KEY_ID=
KEY_SECRET=
# Conversation specific variables
# REQUIRED in the multi-tenant modes: the server refuses to start without it and it cannot be
# overridden per request. Optional for server-credentials and stdio (defaults to "us").
CONVERSATION_REGION=
DEFAULT_SMS_ORIGINATOR=
GEOCODING_API_KEY=
# Verification / Voice tools related environment variables for authentication
APPLICATION_KEY=
APPLICATION_SECRET=
# Voice specific variable
CALLING_LINE_IDENTIFICATION=
# Mailgun tools related environment variables
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_SENDER_ADDRESS=

# LLM integration/eval test suites: provider keys (see tests/integration/llms/README.md)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM test suites: optional model overrides (provider/model)
OPENAI_MODEL= # openai/gpt-5-mini, openai/gpt-5-nano, openai/gpt-5.6-terra, openai/gpt-5.6-luna
ANTHROPIC_MODEL=
GEMINI_MODEL= # google/gemini-3.1-pro, google/gemini-3.5-flash, google/gemini-2.5-pro
WORKFLOW_MODEL=

# OpenTelemetry (optional — enabled only when OTEL_EXPORTER_OTLP_ENDPOINT is set)
# Local stdio usage: leave unset (telemetry disabled, zero overhead).
# Hosted K8s: injected by Kyverno (kyverno.sinch.com/add-otel-endpoint: "enabled") or Helm.
# Typical cluster-local collector endpoint (OTLP gRPC):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy-daemonset.otel-collector.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sinch-mcp-server
OTEL_PROPAGATORS=tracecontext,baggage
LOG_LEVEL=info
